# Configuración para registro de backend
# Copiar este archivo a .register-backend.env y actualizar los valores

# Nombre único del backend
NAME=desa

# URL del backend (usar si no usa USE_PUBLIC_IP)
BACKEND_URL=http://181.87.25.165:3004

# Token secreto del backend
BACKEND_TOKEN=desarrollotoken

# Puerto del backend (requerido si USE_PUBLIC_IP=true)
BACKEND_PORT=3004

# Prefix para el enrutamiento (ej: /desa, /miapi)
PREFIX=/desa

# URL del KV Storage
REGISTRY_URL=https://kv-storage-api.jferreyradev.deno.net

# API key para autenticar contra el KV Storage
API_KEY=pi3_141516

# Clave para encriptar el token del backend
ENCRYPTION_KEY=litos123

# Auto-detectar IP pública (útil si está detrás de NAT)
# true o false
USE_PUBLIC_IP=false

# Modo daemon: re-registrar cada 30 minutos
# true o false
DAEMON=false
